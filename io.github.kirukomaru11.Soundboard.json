{
    "app-id" : "io.github.kirukomaru11.Soundboard",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "master",
    "sdk" : "org.gnome.Platform",
    "command" : "soundboard",
    "finish-args" : [ "--device=dri", "--share=network", "--socket=pulseaudio", "--socket=wayland" ],
    "modules" : [
        {
            "name" : "main",
            "buildsystem" : "simple",
            "build-commands" : [ "mv utils/* .", "env", "python ${FLATPAK_ID##*.}.py --install" ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Soundboard.git",
                    "branch" : "main"
                },
                {
                    "type" : "git",
                    "url" : "https://github.com/kirukomaru11/Utils.git",
                    "branch" : "main",
                    "dest" : "utils"
                }
            ]
        }
    ]
}